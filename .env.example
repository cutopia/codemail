# Email Configuration
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Your email credentials (use app password for Gmail)
EMAIL_ADDRESS=your_email@example.com
EMAIL_PASSWORD=your_app_password_here

# LLM Configuration (LM Studio local endpoint)
LLM_ENDPOINT=http://127.0.0.1:1234/v1
LLM_API_KEY=dummy_key  # LM Studio doesn't require real API key locally

# Task Database
DATABASE_URL=sqlite:///tasks.db

# Redis Configuration (for Celery queue - optional for Phase 1)
REDIS_URL=redis://localhost:6379/0

EMAIL_WHITELIST_SENDERS="allowed_sender1@example.com,allowed_sender2@example.com"
EMAIL_WHITELIST_RECIPIENTS="your_email@example.com"

# Context Window Configuration (in tokens)
# For models with large context windows, set this to take full advantage
# Example: 262144 for models with massive context windows
LLM_MAX_TOKENS=262144

# LLM Debug Logging
# Set to true to log all inputs and outputs to/from the LLM for debugging
LLM_DEBUG_LOGGING=true
